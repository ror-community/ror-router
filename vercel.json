{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/search$",
      "dest": "${SEARCH_APP_URL}/search",
      "env": ["SEARCH_APP_URL"]
    },
    {
      "src": "^/search/(.*)$",
      "dest": "${SEARCH_APP_URL}/search/$1",
      "env": ["SEARCH_APP_URL"]
    },
    {
      "src": "^/0(.*)$",
      "dest": "${SEARCH_APP_URL}/0$1",
      "env": ["SEARCH_APP_URL"]
    },
        {
      "src": "^/_next(?:/.*)?$",
      "dest": "${SEARCH_APP_URL}$0",
      "env": ["SEARCH_APP_URL"]
    },
    {
      "src": "^/(?:favicon\\.ico|robots\\.txt|sitemap\\.xml|images/.*)$",
      "dest": "${SEARCH_APP_URL}$0",
      "env": ["SEARCH_APP_URL"]
    },
    {
      "src": "^(.*)$",
      "dest": "${MAIN_APP_URL}$0",
      "env": ["MAIN_APP_URL"]
    }
  ]
}
